# Copiar a .env (local) o pegar en Portainer → Environment variables.
# Todas son opcionales: los valores mostrados son los defectos. No hay secretos.

# Puerto del host donde escucha el juego (el proxy externo con TLS apunta aquí).
# WEB_BIND: 127.0.0.1 = solo esta máquina (proxy en el mismo host); 0.0.0.0 = toda la red.
WEB_BIND=127.0.0.1
WEB_PORT=8080

# Límites del motor (ver README, sección Configuración)
GMAT_WEB_WORKERS=2
GMAT_WEB_TASK_TIMEOUT=60
GMAT_WEB_MAX_RUNS=2
GMAT_WEB_RUN_TIMEOUT=300
GMAT_WEB_MAX_SCRIPT_BYTES=524288
GMAT_WEB_RUN_KEEP=3600

# Tamaño del tmpfs de corridas y memoria máxima del contenedor
GMAT_WEB_RUNS_SIZE=1g
APP_MEM_LIMIT=4g

# Descarga de GMAT en el build (400 MB). Si el mirror automático de SourceForge va lento, fijar uno:
# GMAT_URL=https://cytranet.dl.sourceforge.net/project/gmat/GMAT/GMAT-R2026a/gmat-ubuntu-x64-R2026a.tar.gz?viasf=1
# El Dockerfile comprueba el sha256, así que cualquier mirror sirve.
